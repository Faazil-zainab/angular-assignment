# ---------------------------------------------------------------------------
# Test fixture - loaded with `node --env-file=.env.test`.
#
# Values here are already in process.env before `dotenv` runs, and dotenv never
# overrides existing variables, so this file wins over `.env` during tests.
# Tests therefore never read or write the development data store.
# ---------------------------------------------------------------------------

NODE_ENV=test
APP_NAME=MPloyChek API (test)
APP_VERSION=1.0.0

API_PREFIX=/api

# Keep the suite output focused on assertions, not access logs.
LOG_LEVEL=error

# No artificial latency - tests assert real behaviour, not waiting.
API_DELAY_MS=0
API_DELAY_MAX_MS=5000

JWT_SECRET=mploychek-test-secret-not-for-production
JWT_EXPIRES_IN_SECONDS=3600
JWT_ISSUER=mploychek-api
JWT_AUDIENCE=mploychek-spa
SEED_USERS=true

# Sandbox store: backend/data/.test/{users,records}.json
STORAGE_DRIVER=json-file
STORAGE_DIR=data/.test
STORAGE_USERS_FILE=users.json
STORAGE_RECORDS_FILE=records.json
