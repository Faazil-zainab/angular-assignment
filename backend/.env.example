# ---------------------------------------------------------------------------
# MPloyChek API - environment configuration
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# Every key below has the same value as its built-in default, so the API runs
# with no .env file at all.
# ---------------------------------------------------------------------------

# Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
APP_NAME=MPloyChek API
APP_VERSION=1.0.0

# HTTP server -----------------------------------------------------------
HOST=0.0.0.0
PORT=3000
# Every REST route is mounted under this prefix, e.g. GET /api/health
API_PREFIX=/api

# Browser origins allowed to call this API (comma separated, * to allow all)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Maximum accepted JSON request body
JSON_BODY_LIMIT=1mb

# Observability ---------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=info

# Artificial latency ----------------------------------------------------
# Simulates slow "background verification" calls so the SPA can demonstrate
# asynchronous/loading states. Applied to every /api request.
# Can be overridden per request with ?delay=<ms> (validated 0..10000; invalid = 400).
API_DELAY_MS=0
API_DELAY_MAX_MS=10000

# Authentication --------------------------------------------------------
# HMAC key used to sign JWTs. REQUIRED in production, where it must be at
# least 32 characters and must not be one of the placeholder values.
# NEVER commit a real secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-this-secret
# Access token lifetime in seconds (60 .. 604800)
JWT_EXPIRES_IN_SECONDS=3600
# Claims validated on every request
JWT_ISSUER=mploychek-api
JWT_AUDIENCE=mploychek-spa
# Create the development data (users + records) when the store is empty.
# Defaults to true outside production.
SEED_USERS=true

# Persistence (local JSON store - no external database) ------------------
# Directory holding one JSON document per collection, relative to backend/.
STORAGE_DRIVER=json-file
STORAGE_DIR=data
STORAGE_USERS_FILE=users.json
STORAGE_RECORDS_FILE=records.json
